{
  "hooks": [
    {
      "event": "PostToolUse",
      "matcher": {
        "tool": "Write",
        "filePath": "src/example-project/**/*.ts"
      },
      "command": "npx eslint --fix $FILE_PATH && npx jest --findRelatedTests $FILE_PATH --passWithNoTests"
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "tool": "Edit",
        "filePath": "src/example-project/**/*.ts"
      },
      "command": "npx eslint --fix $FILE_PATH && npx jest --findRelatedTests $FILE_PATH --passWithNoTests"
    },
    {
      "event": "PreToolUse",
      "matcher": {
        "tool": "Bash",
        "command": "rm -rf|git push.*--force|DROP TABLE|DELETE FROM"
      },
      "command": "echo 'BLOCKED: Dangerous command detected' && exit 1"
    },
    {
      "event": "Notification",
      "matcher": {
        "event": "taskComplete"
      },
      "command": "osascript -e 'display notification \"Claude finished your task\" with title \"Claude Code\"' 2>/dev/null || true"
    }
  ]
}
